
[Unit]
Description=Llama.cpp Server
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/pai/.env
ExecStart=/usr/bin/llama-server \
  -m /path/to/your/model.gguf \
  -c 53248 \
  -ngl 40 \
  -np 1 \
  -fa on \
  -t 6 \
  -b 512 \
  -ub 512 \
  -ctk q8_0 \
  -ctv q8_0 \
  --jinja \
  --host 127.0.0.1 \
  --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
